# OccasionX production settings for docker-compose.yml.
#
# Copy to `.env` on the server and fill in every value. `.env` is
# gitignored - never commit it. Generate each secret with
#   python -c "import secrets; print(secrets.token_hex(32))"
# (hex keeps passwords safe to embed in database/redis URLs - avoid
# characters like @ : / # in DB_PASSWORD and REDIS_PASSWORD).

# ---------------------------------------------------------------- domains
# DNS A records for both must point at the server before first start;
# Caddy then fetches HTTPS certificates automatically.
WEB_DOMAIN=occasionx.com
API_DOMAIN=api.occasionx.com
ACME_EMAIL=ops@occasionx.com

# --------------------------------------------------------------- database
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_USER=occasionx
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ------------------------------------------------------------------- auth
# Long random string, shared by every service that issues/verifies logins.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin account created on first start (password: long and unique).
SUPER_ADMIN_EMAIL=admin@occasionx.com
SUPER_ADMIN_PASSWORD=change-me

# --------------------------------------------------------------- payments
# Live keys move real money. PAYMENT_TEST_MODE=true skips Razorpay
# entirely (QA only) - it must be false for a real launch.
PAYMENT_TEST_MODE=false
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=change-me

# ------------------------------------------------------------------ email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --------------------------------------------------------------- whatsapp
# WARNING: while WHATSAPP_TEST_MODE=true, OTP codes are returned in API
# responses instead of being sent, so anyone can complete OTP login for
# any account. Set to false (with the Meta credentials below) before the
# site is opened to the public.
WHATSAPP_TEST_MODE=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# --------------------------------------------------------------------- AI
# Optional: leave blank to show the "not configured" message instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
