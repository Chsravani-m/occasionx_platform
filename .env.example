# OccasionX production settings for docker-compose.yml.
#
# Copy to `.env` on the server and fill in every value. `.env` is
# gitignored - never commit it. Generate each secret with
#   python -c "import secrets; print(secrets.token_hex(32))"
# (hex keeps passwords safe to embed in database/redis URLs - avoid
# characters like @ : / # in DB_PASSWORD and REDIS_PASSWORD).

# ---------------------------------------------------------------- domains
# DNS A records for both must point at the server before first start;
# Caddy then fetches HTTPS certificates automatically.
WEB_DOMAIN=occasionx.com
API_DOMAIN=api.occasionx.com
ACME_EMAIL=ops@occasionx.com

# --------------------------------------------------------------- database
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_USER=occasionx
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ------------------------------------------------------------------- auth
# Long random string, shared by every service that issues/verifies logins.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional: key the services use to call each other. Derived from
# SECRET_KEY when left unset.
# INTERNAL_API_KEY=

# Admin account created on first start (password: long and unique).
SUPER_ADMIN_EMAIL=admin@occasionx.com
SUPER_ADMIN_PASSWORD=change-me

# --------------------------------------------------------------- payments
# Live keys move real money. PAYMENT_TEST_MODE=true skips Razorpay
# entirely (QA only) - it must be false for a real launch.
PAYMENT_TEST_MODE=false
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=change-me
# Razorpay dashboard -> Settings -> Webhooks: add
#   https://<API_DOMAIN>/payments/webhook/razorpay
# with events payment.captured and order.paid, and paste the same
# secret here. Confirms payments even if the customer closes the tab.
RAZORPAY_WEBHOOK_SECRET=change-me

# Fees in paise (100 paise = Rs.1). Defaults: membership Rs.499,
# per-booking service charge Rs.99, provider registration Rs.999.
# The web/mobile apps show Rs.99 for the booking charge - update
# BOOKING_CHARGE_AMOUNT in frontend/web-app/src/utils/pricing.ts too if
# you change it.
MEMBERSHIP_FEE_PAISE=49900
BOOKING_CHARGE_AMOUNT_PAISE=9900
PROVIDER_REGISTRATION_FEE_PAISE=99900

# ------------------------------------------------------------------ email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --------------------------------------------------------------- whatsapp
# OTP codes (provider sign-up, OTP login) are sent over WhatsApp, so the
# Meta credentials below are REQUIRED for providers to register.
# WHATSAPP_TEST_MODE=true only logs messages instead of sending them; in
# production (APP_ENV=production) the codes are never returned in API
# responses either, so with test mode on nobody can complete OTP steps.
WHATSAPP_TEST_MODE=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# --------------------------------------------------------------------- AI
# Optional: leave blank to show the "not configured" message instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
